@@ -0,0 +1,65 @@
+// @effect-diagnostics globalDate:off -- A wall-clock probe cache shared across IPC calls.
+import * as HostProcess from "@t3tools/shared/HostProcess";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import * as Transcription from "../../dictation/whisperTranscription.ts";
+import * as DesktopIpc from "../DesktopIpc.ts";
+import * as IpcChannels from "../channels.ts";
+
+const TranscriptionStatus = Schema.Struct({
+  available: Schema.Boolean,
+  backend: Schema.NullOr(Schema.String),
+  detail: Schema.NullOr(Schema.String),
+});
+
+const TranscribeAudioRequest = Schema.Struct({
+  audioBase64: Schema.String.check(Schema.isMaxLength(9 * 1024 * 1024)),
+  mimeType: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
+  language: Schema.optional(Schema.String.check(Schema.isMaxLength(8))),
+});
+
+const TranscribeAudioOutcome = Schema.Union([
+  Schema.Struct({ ok: Schema.Literal(true), text: Schema.String }),
+  Schema.Struct({ ok: Schema.Literal(false), message: Schema.String }),
+]);
+
+/** A probe spawns ssh in ssh mode; several composers asking at once share one. */
+const PROBE_CACHE_MS = 15_000;
+let cachedProbe: {
+  readonly at: number;
+  readonly status: Promise<Transcription.TranscriptionStatus>;
+} | null = null;
+
+function probe(env: NodeJS.ProcessEnv, force: boolean): Promise<Transcription.TranscriptionStatus> {
+  const now = Date.now();
+  if (!force && cachedProbe && now - cachedProbe.at < PROBE_CACHE_MS) return cachedProbe.status;
+  const status = Transcription.probeTranscription(Transcription.resolveTranscriptionBackend(env));
+  cachedProbe = { at: now, status };
+  return status;
+}
+
+export const getDictationStatus = DesktopIpc.makeIpcMethod({
+  channel: IpcChannels.GET_DICTATION_STATUS_CHANNEL,
+  payload: Schema.Boolean,
+  result: TranscriptionStatus,
+  handler: Effect.fn("desktop.ipc.dictation.status")(function* (force) {
+    const env = yield* HostProcess.Environment;
+    return yield* Effect.promise(() => probe(env, force));
+  }),
+});
+
+export const transcribeDictation = DesktopIpc.makeIpcMethod({
+  channel: IpcChannels.TRANSCRIBE_DICTATION_CHANNEL,
+  payload: TranscribeAudioRequest,
+  result: TranscribeAudioOutcome,
+  handler: Effect.fn("desktop.ipc.dictation.transcribe")(function* (request) {
+    const env = yield* HostProcess.Environment;
+    const outcome = yield* Effect.promise(() =>
+      Transcription.transcribeAudio(Transcription.resolveTranscriptionBackend(env), request),
+    );
+    // A failed upload says more about reachability than an old probe.
+    if (!outcome.ok) cachedProbe = null;
+    return outcome;
+  }),
+});
