diff --git a/apps/web/src/components/chat/DictationButton.tsx b/apps/web/src/components/chat/DictationButton.tsx
new file mode 100644
index 0000000000..5dfd63e08c
--- /dev/null
+++ b/apps/web/src/components/chat/DictationButton.tsx
@@ -0,0 +1,130 @@
+import type { EnvironmentId } from "@t3tools/contracts";
+import { LoaderCircleIcon, MicIcon, SquareIcon } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+
+import { Button } from "../ui/button";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import {
+  type DictationTranscribe,
+  dictationSession,
+  dictationTargetKey,
+  useDictationSession,
+} from "./dictationSession";
+import { useDictationAvailability } from "./dictationAvailability";
+
+function formatElapsed(ms: number): string {
+  const seconds = Math.floor(ms / 1000);
+  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
+}
+
+const transcribeThroughDesktop: DictationTranscribe = async (input) => {
+  const transcribe = window.desktopBridge?.transcribeDictation;
+  if (!transcribe) return { ok: false, message: "Dictation needs the T3 Code desktop app." };
+  try {
+    return await transcribe(input);
+  } catch (cause) {
+    return { ok: false, message: cause instanceof Error ? cause.message : "Transcription failed." };
+  }
+};
+
+/**
+ * Click to record, click again to stop; the desktop app sends the clip to a
+ * whisper.cpp server (see apps/desktop/src/dictation) and the text lands at
+ * the caret of the composer that started it. Escape while recording throws
+ * the clip away. Renders nothing unless that server answers, so web, mobile
+ * and machines without a speech backend never see a dead button.
+ *
+ * The recording itself lives in `dictationSession`, so this button can
+ * unmount (thread switch, layout change) without losing it; a transcript for
+ * a composer that is not mounted is held and inserted when it returns.
+ */
+export function DictationButton(props: {
+  readonly environmentId: EnvironmentId;
+  /** Identifies this composer (draft or thread) within the environment. */
+  readonly composerKey: string;
+  readonly disabled?: boolean;
+  /** Inserts the text; returns false when the composer could not take it. */
+  readonly onTranscript: (text: string) => boolean;
+}) {
+  const { environmentId, composerKey, onTranscript } = props;
+  const targetKey = dictationTargetKey(environmentId, composerKey);
+  const session = useDictationSession();
+  const availability = useDictationAvailability();
+  const [elapsedMs, setElapsedMs] = useState(0);
+
+  const onTranscriptRef = useRef(onTranscript);
+  useEffect(() => {
+    onTranscriptRef.current = onTranscript;
+  }, [onTranscript]);
+
+  useEffect(
+    () => dictationSession.registerDeliverer(targetKey, (text) => onTranscriptRef.current(text)),
+    [targetKey],
+  );
+
+  const recording = session.phase === "recording";
+
+  // Display-only timer; the cap is enforced by the session.
+  useEffect(() => {
+    if (!recording) return;
+    const tick = () => setElapsedMs(Date.now() - session.startedAt);
+    tick();
+    const id = window.setInterval(tick, 250);
+    return () => window.clearInterval(id);
+  }, [recording, session.startedAt]);
+
+  const start = () => {
+    void dictationSession.start(targetKey, transcribeThroughDesktop);
+  };
+
+  // Never hide a session in progress, even if the backend just dropped.
+  if (!availability.available && session.phase === "idle") return null;
+
+  const busy = session.phase === "starting" || session.phase === "transcribing";
+  const label = recording
+    ? "Stop and transcribe (Esc to discard)"
+    : session.phase === "transcribing"
+      ? "Transcribing…"
+      : "Dictate a prompt";
+
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <Button
+            type="button"
+            variant={recording ? "ghost-destructive" : "ghost"}
+            size={recording ? "sm" : "icon-sm"}
+            disabled={(props.disabled && !recording) || busy}
+            onPointerDown={(event) => event.preventDefault()}
+            onClick={() => (recording ? dictationSession.stop(false) : start())}
+            aria-label={label}
+            aria-pressed={recording}
+            data-testid="composer-dictation-button"
+          />
+        }
+      >
+        {recording ? (
+          <>
+            <span className="relative flex size-2">
+              <span className="absolute inline-flex size-full animate-ping rounded-full bg-destructive opacity-60 motion-reduce:animate-none" />
+              <span className="relative inline-flex size-2 rounded-full bg-destructive" />
+            </span>
+            <span className="text-xs tabular-nums">{formatElapsed(elapsedMs)}</span>
+            <SquareIcon className="size-3 fill-current" />
+          </>
+        ) : busy ? (
+          <LoaderCircleIcon className="animate-spin" />
+        ) : (
+          <MicIcon />
+        )}
+      </TooltipTrigger>
+      <TooltipPopup>
+        {label}
+        {availability.backend && session.phase === "idle" ? (
+          <span className="block text-muted-foreground text-xs">{availability.backend}</span>
+        ) : null}
+      </TooltipPopup>
+    </Tooltip>
+  );
+}
diff --git a/apps/web/src/components/chat/dictationAvailability.test.ts b/apps/web/src/components/chat/dictationAvailability.test.ts
new file mode 100644
index 0000000000..e54fd2f2b2
--- /dev/null
+++ b/apps/web/src/components/chat/dictationAvailability.test.ts
@@ -0,0 +1,126 @@
+import type { DesktopDictationStatus } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { POLL_MS, createDictationAvailabilityStore } from "./dictationAvailability";
+
+function harness(probe?: (force: boolean) => Promise<DesktopDictationStatus>) {
+  const intervals = new Map<number, () => void>();
+  let nextId = 1;
+  const resumeHandlers = new Set<() => void>();
+  const calls: boolean[] = [];
+  const store = createDictationAvailabilityStore({
+    probe: probe
+      ? (force) => {
+          calls.push(force);
+          return probe(force);
+        }
+      : undefined,
+    setInterval(handler, ms) {
+      expect(ms).toBe(POLL_MS);
+      const id = nextId++;
+      intervals.set(id, handler);
+      return id;
+    },
+    clearInterval(handle) {
+      intervals.delete(handle as number);
+    },
+    onResume(handler) {
+      resumeHandlers.add(handler);
+      return () => resumeHandlers.delete(handler);
+    },
+  });
+  const tick = () => {
+    for (const handler of intervals.values()) handler();
+  };
+  const resume = () => {
+    for (const handler of resumeHandlers) handler();
+  };
+  return { store, intervals, resumeHandlers, calls, tick, resume };
+}
+
+/** Lets queued promise callbacks run; the store under test only awaits promises. */
+async function flush(): Promise<void> {
+  for (let index = 0; index < 10; index++) await Promise.resolve();
+}
+
+const up: DesktopDictationStatus = {
+  available: true,
+  backend: "whisper via ssh pgx",
+  detail: null,
+};
+const down: DesktopDictationStatus = {
+  available: false,
+  backend: "whisper via ssh pgx",
+  detail: "x",
+};
+
+describe("dictation availability", () => {
+  it("is never available outside the desktop app", async () => {
+    const { store, intervals } = harness();
+    const release = store.retain();
+    await flush();
+    expect(store.getSnapshot().available).toBe(false);
+    expect(intervals.size).toBe(0);
+    release();
+  });
+
+  it("shows the button only while the backend answers", async () => {
+    let status = down;
+    const { store, tick, resume, calls } = harness(() => Promise.resolve(status));
+    let notified = 0;
+    store.subscribe(() => notified++);
+    const release = store.retain();
+    await flush();
+    expect(store.getSnapshot()).toEqual({ available: false, backend: null });
+
+    status = up;
+    tick();
+    await flush();
+    expect(store.getSnapshot()).toEqual({ available: true, backend: "whisper via ssh pgx" });
+
+    status = down;
+    resume();
+    await flush();
+    expect(store.getSnapshot().available).toBe(false);
+    expect(calls).toEqual([false, false, true]);
+    expect(notified).toBe(2);
+    release();
+  });
+
+  it("treats a failing probe as unavailable", async () => {
+    const { store } = harness(() => Promise.reject(new Error("ipc gone")));
+    const release = store.retain();
+    await flush();
+    expect(store.getSnapshot().available).toBe(false);
+    release();
+  });
+
+  it("polls only while some button is mounted", async () => {
+    const { store, intervals, resumeHandlers, calls } = harness(() => Promise.resolve(up));
+    const releaseA = store.retain();
+    const releaseB = store.retain();
+    expect(calls).toHaveLength(1);
+    expect(intervals.size).toBe(1);
+    releaseA();
+    releaseA();
+    expect(intervals.size).toBe(1);
+    releaseB();
+    expect(intervals.size).toBe(0);
+    expect(resumeHandlers.size).toBe(0);
+    await flush();
+  });
+
+  it("ignores a slow answer that a newer check overtook", async () => {
+    const resolvers: Array<(status: DesktopDictationStatus) => void> = [];
+    const { store, resume } = harness(
+      () => new Promise<DesktopDictationStatus>((resolve) => resolvers.push(resolve)),
+    );
+    const release = store.retain();
+    resume();
+    resolvers[1]!(down);
+    resolvers[0]!(up);
+    await flush();
+    expect(store.getSnapshot().available).toBe(false);
+    release();
+  });
+});
diff --git a/apps/web/src/components/chat/dictationAvailability.ts b/apps/web/src/components/chat/dictationAvailability.ts
new file mode 100644
index 0000000000..9fc2b78168
--- /dev/null
+++ b/apps/web/src/components/chat/dictationAvailability.ts
@@ -0,0 +1,126 @@
+import type { DesktopDictationStatus } from "@t3tools/contracts";
+import { useEffect, useSyncExternalStore } from "react";
+
+/**
+ * Whether the desktop app can reach a speech-to-text backend right now. One
+ * app-wide store: every composer shares the same answer, and the probe runs
+ * only while some mic button is mounted.
+ *
+ * Re-checked every POLL_MS while visible and immediately when the window
+ * regains focus (the usual moment a tunnel or VPN came back).
+ */
+
+export interface DictationAvailability {
+  readonly available: boolean;
+  readonly backend: string | null;
+}
+
+export interface DictationAvailabilityDeps {
+  /** Absent outside the desktop app: dictation is then never available. */
+  readonly probe: ((force: boolean) => Promise<DesktopDictationStatus>) | undefined;
+  setInterval(handler: () => void, ms: number): unknown;
+  clearInterval(handle: unknown): void;
+  /** Subscribes to "the user is back" signals; returns the unsubscribe. */
+  onResume(handler: () => void): () => void;
+}
+
+export const POLL_MS = 30_000;
+
+const UNAVAILABLE: DictationAvailability = { available: false, backend: null };
+
+export function createDictationAvailabilityStore(deps: DictationAvailabilityDeps) {
+  let snapshot: DictationAvailability = UNAVAILABLE;
+  const listeners = new Set<() => void>();
+  let users = 0;
+  let timer: unknown = null;
+  let removeResume: (() => void) | null = null;
+  let generation = 0;
+
+  function set(next: DictationAvailability) {
+    if (next.available === snapshot.available && next.backend === snapshot.backend) return;
+    snapshot = next;
+    for (const listener of listeners) listener();
+  }
+
+  async function check(force: boolean): Promise<void> {
+    const probe = deps.probe;
+    if (!probe) return;
+    const mine = ++generation;
+    try {
+      const status = await probe(force);
+      if (mine !== generation) return;
+      set({ available: status.available, backend: status.available ? status.backend : null });
+    } catch {
+      if (mine === generation) set(UNAVAILABLE);
+    }
+  }
+
+  /** A mounted mic button keeps the probe running; returns the release. */
+  function retain(): () => void {
+    users += 1;
+    if (users === 1 && deps.probe) {
+      void check(false);
+      timer = deps.setInterval(() => void check(false), POLL_MS);
+      removeResume = deps.onResume(() => void check(true));
+    }
+    let released = false;
+    return () => {
+      if (released) return;
+      released = true;
+      users -= 1;
+      if (users > 0) return;
+      if (timer !== null) deps.clearInterval(timer);
+      timer = null;
+      removeResume?.();
+      removeResume = null;
+    };
+  }
+
+  return {
+    getSnapshot: () => snapshot,
+    subscribe(listener: () => void): () => void {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    retain,
+    check,
+  };
+}
+
+export type DictationAvailabilityStore = ReturnType<typeof createDictationAvailabilityStore>;
+
+function browserDeps(): DictationAvailabilityDeps {
+  const bridge = typeof window === "undefined" ? undefined : window.desktopBridge;
+  const probe = bridge?.getDictationStatus;
+  return {
+    probe: probe ? (force) => probe(force) : undefined,
+    setInterval: (handler, ms) => window.setInterval(handler, ms),
+    clearInterval: (handle) => window.clearInterval(handle as number),
+    onResume(handler) {
+      const onVisible = () => {
+        if (document.visibilityState === "visible") handler();
+      };
+      window.addEventListener("focus", handler);
+      document.addEventListener("visibilitychange", onVisible);
+      return () => {
+        window.removeEventListener("focus", handler);
+        document.removeEventListener("visibilitychange", onVisible);
+      };
+    },
+  };
+}
+
+let appStore: DictationAvailabilityStore | null = null;
+function store(): DictationAvailabilityStore {
+  appStore ??= createDictationAvailabilityStore(browserDeps());
+  return appStore;
+}
+
+export function useDictationAvailability(): DictationAvailability {
+  useEffect(() => store().retain(), []);
+  return useSyncExternalStore(
+    (listener) => store().subscribe(listener),
+    () => store().getSnapshot(),
+    () => UNAVAILABLE,
+  );
+}
