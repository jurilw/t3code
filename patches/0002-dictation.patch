--- /dev/null
+++ b/apps/desktop/src/dictation/whisperTranscription.ts
@@ -0,0 +1,343 @@
+// @effect-diagnostics globalTimers:off -- Request deadlines run outside Effect fibers.
+// @effect-diagnostics nodeBuiltinImport:off -- This desktop-only helper owns an ssh child process.
+// @effect-diagnostics globalFetch:off -- The main process posts clips with Node fetch; no Effect runtime here.
+import * as NodeChildProcess from "node:child_process";
+
+/**
+ * Dictation for the desktop app, done entirely by the desktop (main process).
+ *
+ * Why not the T3 server: the server the app talks to is often the official
+ * build on a remote host (SSH environments, the iPhone app's server), and a
+ * patched desktop must keep working against it. So the desktop sends each clip
+ * to a whisper.cpp `whisper-server` itself, either
+ *
+ *   - over HTTP (`T3CODE_TRANSCRIBE_URL`, default http://127.0.0.1:8178/inference,
+ *     e.g. a local whisper-server or a manual `ssh -L 8178:127.0.0.1:8178 host`), or
+ *   - through `ssh <T3CODE_TRANSCRIBE_SSH_HOST> curl ...` to a whisper-server
+ *     listening on that host's loopback (`T3CODE_TRANSCRIBE_REMOTE_URL`, same
+ *     default). No tunnel or port to manage; uses the user's ssh config and keys
+ *     non-interactively (BatchMode).
+ *
+ * The mic button is shown only while the configured backend answers a probe.
+ * `T3CODE_TRANSCRIBE_URL=off` turns dictation off.
+ */
+
+export const DEFAULT_TRANSCRIBE_URL = "http://127.0.0.1:8178/inference";
+export const TRANSCRIBE_TIMEOUT_MS = 120_000;
+export const PROBE_TIMEOUT_MS = 8_000;
+/** Same cap as a few minutes of opus; anything bigger is a stuck recorder. */
+export const MAX_AUDIO_BYTES = 6 * 1024 * 1024;
+
+export type TranscriptionBackend =
+  | { readonly kind: "http"; readonly url: string }
+  | { readonly kind: "ssh"; readonly host: string; readonly remoteUrl: string };
+
+export interface TranscriptionStatus {
+  readonly available: boolean;
+  /** Where clips go, for the tooltip; null when dictation is off. */
+  readonly backend: string | null;
+  readonly detail: string | null;
+}
+
+export interface TranscribeAudioRequest {
+  readonly audioBase64: string;
+  readonly mimeType: string;
+  readonly language?: string | undefined;
+}
+
+export type TranscribeAudioOutcome =
+  | { readonly ok: true; readonly text: string }
+  | { readonly ok: false; readonly message: string };
+
+const SSH_HOST_PATTERN = /^[A-Za-z0-9_.@:-]+$/;
+const LANGUAGE_PATTERN = /^[a-z]{2,3}$/;
+
+export function resolveTranscriptionBackend(
+  env: Readonly<Record<string, string | undefined>>,
+): TranscriptionBackend | null {
+  const url = env.T3CODE_TRANSCRIBE_URL?.trim();
+  if (url === "off") return null;
+  const host = env.T3CODE_TRANSCRIBE_SSH_HOST?.trim();
+  if (host) {
+    // The host goes on the ssh command line; refuse anything that could be an option.
+    if (!SSH_HOST_PATTERN.test(host) || host.startsWith("-")) return null;
+    const remoteUrl = env.T3CODE_TRANSCRIBE_REMOTE_URL?.trim() || DEFAULT_TRANSCRIBE_URL;
+    if (!isHttpUrl(remoteUrl)) return null;
+    return { kind: "ssh", host, remoteUrl };
+  }
+  const httpUrl = url || DEFAULT_TRANSCRIBE_URL;
+  return isHttpUrl(httpUrl) ? { kind: "http", url: httpUrl } : null;
+}
+
+function isHttpUrl(value: string): boolean {
+  try {
+    const parsed = new URL(value);
+    return parsed.protocol === "http:" || parsed.protocol === "https:";
+  } catch {
+    return false;
+  }
+}
+
+export function describeBackend(backend: TranscriptionBackend): string {
+  return backend.kind === "http" ? backend.url : `${backend.remoteUrl} via ssh ${backend.host}`;
+}
+
+/** whisper-server's root page answers 200; any HTTP answer means it is up. */
+export function probeUrlFor(inferenceUrl: string): string {
+  return new URL("/", inferenceUrl).toString();
+}
+
+export function extensionFor(mimeType: string): string {
+  const base = baseMimeType(mimeType);
+  if (base.endsWith("/ogg")) return "ogg";
+  if (base.endsWith("/mp4") || base.endsWith("/m4a")) return "m4a";
+  if (base.endsWith("/wav") || base.endsWith("/x-wav")) return "wav";
+  if (base.endsWith("/mpeg")) return "mp3";
+  return "webm";
+}
+
+/** `audio/webm;codecs=opus` -> `audio/webm`; whisper-server --convert sniffs the rest. */
+export function baseMimeType(mimeType: string): string {
+  const base = mimeType.split(";")[0]?.trim().toLowerCase() ?? "";
+  return /^[a-z]+\/[a-z0-9.+-]+$/.test(base) ? base : "application/octet-stream";
+}
+
+/** whisper.cpp marks non-speech as `[BLANK_AUDIO]`, `(music)` and the like. */
+export function cleanTranscript(text: string): string {
+  return text
+    .replace(/\[[A-Z_ ]+\]/g, " ")
+    .replace(/\((?:music|silence|inaudible|applause|laughter)\)/gi, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** whisper-server answers `{ text }` on success and `{ error }` on a bad upload. */
+export function parseWhisperResponse(status: number | null, body: string): TranscribeAudioOutcome {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(body);
+  } catch {
+    parsed = undefined;
+  }
+  const record =
+    typeof parsed === "object" && parsed !== null ? (parsed as Record<string, unknown>) : {};
+  if (status !== null && (status < 200 || status >= 300)) {
+    return { ok: false, message: `Transcription failed (${status}): ${body.slice(0, 200)}` };
+  }
+  if (typeof record.text === "string") return { ok: true, text: cleanTranscript(record.text) };
+  const error =
+    typeof record.error === "string" ? record.error : body.slice(0, 200) || "empty response";
+  return { ok: false, message: `Transcription failed: ${error}` };
+}
+
+/** POSIX single-quoting for the remote shell that ssh hands the command to. */
+export function shellQuote(value: string): string {
+  return `'${value.replace(/'/g, `'\\''`)}'`;
+}
+
+export function sshBaseArgs(host: string): string[] {
+  return ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-T", "--", host];
+}
+
+export function sshProbeArgs(backend: Extract<TranscriptionBackend, { kind: "ssh" }>): string[] {
+  const remote = [
+    "curl",
+    "-s",
+    "-o",
+    "/dev/null",
+    "-w",
+    "%{http_code}",
+    "--max-time",
+    "4",
+    probeUrlFor(backend.remoteUrl),
+  ];
+  return [...sshBaseArgs(backend.host), remote.map(shellQuote).join(" ")];
+}
+
+/** curl reads the clip from stdin (`@-`) and prints whisper's JSON. */
+export function sshTranscribeArgs(
+  backend: Extract<TranscriptionBackend, { kind: "ssh" }>,
+  request: Pick<TranscribeAudioRequest, "mimeType" | "language">,
+): string[] {
+  const remote = [
+    "curl",
+    "-sS",
+    "--max-time",
+    String(Math.round(TRANSCRIBE_TIMEOUT_MS / 1000)),
+    "-F",
+    `file=@-;filename=dictation.${extensionFor(request.mimeType)};type=${baseMimeType(request.mimeType)}`,
+    "-F",
+    "response_format=json",
+    "-F",
+    "temperature=0",
+    ...(request.language && LANGUAGE_PATTERN.test(request.language)
+      ? ["-F", `language=${request.language}`]
+      : []),
+    backend.remoteUrl,
+  ];
+  return [...sshBaseArgs(backend.host), remote.map(shellQuote).join(" ")];
+}
+
+export interface ProcessResult {
+  readonly exitCode: number | null;
+  readonly stdout: string;
+  readonly stderr: string;
+}
+
+export interface TranscriptionDeps {
+  readonly fetch: typeof globalThis.fetch;
+  readonly runProcess: (
+    command: string,
+    args: ReadonlyArray<string>,
+    stdin: Uint8Array | null,
+    timeoutMs: number,
+  ) => Promise<ProcessResult>;
+  readonly sshCommand: string;
+}
+
+export function runProcess(
+  command: string,
+  args: ReadonlyArray<string>,
+  stdin: Uint8Array | null,
+  timeoutMs: number,
+): Promise<ProcessResult> {
+  return new Promise((resolve) => {
+    let child: NodeChildProcess.ChildProcess;
+    try {
+      child = NodeChildProcess.spawn(command, [...args], {
+        stdio: ["pipe", "pipe", "pipe"],
+        windowsHide: true,
+      });
+    } catch (cause) {
+      resolve({ exitCode: null, stdout: "", stderr: String(cause) });
+      return;
+    }
+    const stdout: Buffer[] = [];
+    const stderr: Buffer[] = [];
+    let settled = false;
+    const finish = (exitCode: number | null, extra = "") => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      resolve({
+        exitCode,
+        stdout: Buffer.concat(stdout).toString("utf8"),
+        stderr: Buffer.concat(stderr).toString("utf8") + extra,
+      });
+    };
+    const timer = setTimeout(() => {
+      child.kill();
+      finish(null, "timed out");
+    }, timeoutMs);
+    child.stdout?.on("data", (chunk: Buffer) => stdout.push(chunk));
+    child.stderr?.on("data", (chunk: Buffer) => stderr.push(chunk));
+    child.on("error", (error) => finish(null, error.message));
+    child.on("close", (code) => finish(code));
+    child.stdin?.on("error", () => {});
+    if (stdin) child.stdin?.end(Buffer.from(stdin));
+    else child.stdin?.end();
+  });
+}
+
+export const defaultDeps: TranscriptionDeps = {
+  fetch: (input, init) => globalThis.fetch(input, init),
+  runProcess,
+  sshCommand: "ssh",
+};
+
+export async function probeTranscription(
+  backend: TranscriptionBackend | null,
+  deps: TranscriptionDeps = defaultDeps,
+): Promise<TranscriptionStatus> {
+  if (backend === null) {
+    return { available: false, backend: null, detail: "Dictation is turned off." };
+  }
+  const described = describeBackend(backend);
+  if (backend.kind === "http") {
+    try {
+      await deps.fetch(probeUrlFor(backend.url), {
+        method: "GET",
+        signal: AbortSignal.timeout(PROBE_TIMEOUT_MS),
+      });
+      return { available: true, backend: described, detail: null };
+    } catch {
+      return {
+        available: false,
+        backend: described,
+        detail: `No whisper-server at ${backend.url}.`,
+      };
+    }
+  }
+  const result = await deps.runProcess(
+    deps.sshCommand,
+    sshProbeArgs(backend),
+    null,
+    PROBE_TIMEOUT_MS,
+  );
+  const code = Number.parseInt(result.stdout.trim(), 10);
+  if (result.exitCode === 0 && Number.isFinite(code) && code > 0) {
+    return { available: true, backend: described, detail: null };
+  }
+  return {
+    available: false,
+    backend: described,
+    detail: `No whisper-server reachable as ${described}.`,
+  };
+}
+
+export async function transcribeAudio(
+  backend: TranscriptionBackend | null,
+  request: TranscribeAudioRequest,
+  deps: TranscriptionDeps = defaultDeps,
+): Promise<TranscribeAudioOutcome> {
+  if (backend === null) return { ok: false, message: "Dictation is turned off." };
+  const audio = Buffer.from(request.audioBase64, "base64");
+  if (audio.byteLength === 0) return { ok: false, message: "The recording was empty." };
+  if (audio.byteLength > MAX_AUDIO_BYTES) {
+    return { ok: false, message: "The recording is too long to transcribe." };
+  }
+  if (backend.kind === "http") {
+    const form = new FormData();
+    form.append(
+      "file",
+      new Blob([audio], { type: baseMimeType(request.mimeType) }),
+      `dictation.${extensionFor(request.mimeType)}`,
+    );
+    form.append("response_format", "json");
+    form.append("temperature", "0");
+    if (request.language && LANGUAGE_PATTERN.test(request.language)) {
+      form.append("language", request.language);
+    }
+    let response: Response;
+    try {
+      response = await deps.fetch(backend.url, {
+        method: "POST",
+        body: form,
+        signal: AbortSignal.timeout(TRANSCRIBE_TIMEOUT_MS),
+      });
+    } catch {
+      return { ok: false, message: `No speech-to-text server answered at ${backend.url}.` };
+    }
+    let body = "";
+    try {
+      body = await response.text();
+    } catch {
+      return { ok: false, message: "Transcription was cut off." };
+    }
+    return parseWhisperResponse(response.status, body);
+  }
+  const result = await deps.runProcess(
+    deps.sshCommand,
+    sshTranscribeArgs(backend, request),
+    audio,
+    TRANSCRIBE_TIMEOUT_MS + 10_000,
+  );
+  if (result.exitCode !== 0) {
+    const reason = (result.stderr || result.stdout).trim().slice(0, 200) || "no output";
+    return {
+      ok: false,
+      message: `Transcription via ssh ${backend.host} failed (exit ${result.exitCode ?? "none"}): ${reason}`,
+    };
+  }
+  return parseWhisperResponse(null, result.stdout);
+}
