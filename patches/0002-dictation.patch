new file mode 100644
index 0000000000..54dee1e04c
--- /dev/null
+++ b/apps/desktop/src/dictation/whisperTranscription.test.ts
@@ -0,0 +1,182 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  DEFAULT_TRANSCRIBE_URL,
+  type ProcessResult,
+  type TranscriptionDeps,
+  cleanTranscript,
+  parseWhisperResponse,
+  probeTranscription,
+  resolveTranscriptionBackend,
+  shellQuote,
+  sshTranscribeArgs,
+  transcribeAudio,
+} from "./whisperTranscription.ts";
+
+const CLIP = Buffer.from("fake opus bytes").toString("base64");
+
+function depsWith(overrides: Partial<TranscriptionDeps>): TranscriptionDeps {
+  return {
+    fetch: () => Promise.reject(new Error("no network in tests")),
+    runProcess: () => Promise.resolve({ exitCode: 255, stdout: "", stderr: "unreachable" }),
+    sshCommand: "ssh",
+    ...overrides,
+  };
+}
+
+describe("resolveTranscriptionBackend", () => {
+  it("defaults to a whisper-server on this machine's loopback", () => {
+    expect(resolveTranscriptionBackend({})).toEqual({ kind: "http", url: DEFAULT_TRANSCRIBE_URL });
+  });
+
+  it("can be turned off", () => {
+    expect(resolveTranscriptionBackend({ T3CODE_TRANSCRIBE_URL: "off" })).toBeNull();
+    expect(
+      resolveTranscriptionBackend({
+        T3CODE_TRANSCRIBE_URL: "off",
+        T3CODE_TRANSCRIBE_SSH_HOST: "pgx",
+      }),
+    ).toBeNull();
+  });
+
+  it("uses ssh when a host is configured", () => {
+    expect(resolveTranscriptionBackend({ T3CODE_TRANSCRIBE_SSH_HOST: "pgx" })).toEqual({
+      kind: "ssh",
+      host: "pgx",
+      remoteUrl: DEFAULT_TRANSCRIBE_URL,
+    });
+  });
+
+  it("rejects hosts that could be read as ssh options or shell", () => {
+    expect(
+      resolveTranscriptionBackend({ T3CODE_TRANSCRIBE_SSH_HOST: "-oProxyCommand=x" }),
+    ).toBeNull();
+    expect(resolveTranscriptionBackend({ T3CODE_TRANSCRIBE_SSH_HOST: "pgx; rm -rf ~" })).toBeNull();
+  });
+
+  it("rejects non-http urls", () => {
+    expect(resolveTranscriptionBackend({ T3CODE_TRANSCRIBE_URL: "file:///etc/passwd" })).toBeNull();
+  });
+});
+
+describe("whisper responses", () => {
+  it("cleans non-speech markers", () => {
+    expect(cleanTranscript(" [BLANK_AUDIO] hello  (music) world\n")).toBe("hello world");
+  });
+
+  it("reads text, errors and HTTP failures", () => {
+    expect(parseWhisperResponse(200, '{"text":" Hi there.\\n"}')).toEqual({
+      ok: true,
+      text: "Hi there.",
+    });
+    expect(parseWhisperResponse(null, '{"error":"bad audio"}')).toEqual({
+      ok: false,
+      message: "Transcription failed: bad audio",
+    });
+    expect(parseWhisperResponse(500, "boom").ok).toBe(false);
+    expect(parseWhisperResponse(null, "").ok).toBe(false);
+  });
+});
+
+describe("ssh transport", () => {
+  const backend = { kind: "ssh", host: "pgx", remoteUrl: DEFAULT_TRANSCRIBE_URL } as const;
+
+  it("quotes the remote command for a POSIX shell", () => {
+    expect(shellQuote("it's")).toBe(`'it'\\''s'`);
+    const args = sshTranscribeArgs(backend, { mimeType: "audio/webm;codecs=opus", language: "en" });
+    expect(args.slice(0, 6)).toEqual(["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-T", "--"]);
+    expect(args[6]).toBe("pgx");
+    expect(args).toHaveLength(8);
+    expect(args[7]).toContain(`'file=@-;filename=dictation.webm;type=audio/webm'`);
+    expect(args[7]).toContain(`'language=en'`);
+    expect(args[7]).toContain(`'${DEFAULT_TRANSCRIBE_URL}'`);
+  });
+
+  it("drops a language hint that is not a plain ISO code", () => {
+    const args = sshTranscribeArgs(backend, { mimeType: "audio/webm", language: "en'; id" });
+    expect(args[7]).not.toContain("language");
+  });
+
+  it("pipes the clip to curl on the host and returns the cleaned text", async () => {
+    const calls: Array<{ args: ReadonlyArray<string>; stdin: Uint8Array | null }> = [];
+    const deps = depsWith({
+      runProcess: (_command, args, stdin): Promise<ProcessResult> => {
+        calls.push({ args, stdin });
+        return Promise.resolve({
+          exitCode: 0,
+          stdout: '{"text":" Ask not. [BLANK_AUDIO]"}',
+          stderr: "",
+        });
+      },
+    });
+    const outcome = await transcribeAudio(
+      backend,
+      { audioBase64: CLIP, mimeType: "audio/webm" },
+      deps,
+    );
+    expect(outcome).toEqual({ ok: true, text: "Ask not." });
+    expect(Buffer.from(calls[0]!.stdin!).toString()).toBe("fake opus bytes");
+  });
+
+  it("reports ssh failures instead of throwing", async () => {
+    const outcome = await transcribeAudio(
+      backend,
+      { audioBase64: CLIP, mimeType: "audio/webm" },
+      depsWith({}),
+    );
+    expect(outcome.ok).toBe(false);
+    if (!outcome.ok) expect(outcome.message).toContain("ssh pgx");
+  });
+
+  it("is available only when curl on the host gets an HTTP answer", async () => {
+    const up = depsWith({
+      runProcess: () => Promise.resolve({ exitCode: 0, stdout: "200", stderr: "" }),
+    });
+    const down = depsWith({
+      runProcess: () => Promise.resolve({ exitCode: 7, stdout: "000", stderr: "" }),
+    });
+    expect((await probeTranscription(backend, up)).available).toBe(true);
+    expect((await probeTranscription(backend, down)).available).toBe(false);
+    expect((await probeTranscription(backend, depsWith({}))).available).toBe(false);
+  });
+});
+
+describe("http transport", () => {
+  const backend = { kind: "http", url: DEFAULT_TRANSCRIBE_URL } as const;
+
+  it("hides the button when nothing listens", async () => {
+    expect((await probeTranscription(backend, depsWith({}))).available).toBe(false);
+    expect((await probeTranscription(null, depsWith({}))).available).toBe(false);
+  });
+
+  it("posts the clip as multipart and reads whisper's JSON", async () => {
+    let seen: { url: string; body: FormData } | null = null;
+    const deps = depsWith({
+      fetch: ((url: string, init: RequestInit) => {
+        seen = { url, body: init.body as FormData };
+        return Promise.resolve(new Response('{"text":"hello"}', { status: 200 }));
+      }) as unknown as typeof fetch,
+    });
+    const outcome = await transcribeAudio(
+      backend,
+      { audioBase64: CLIP, mimeType: "audio/ogg;codecs=opus" },
+      deps,
+    );
+    expect(outcome).toEqual({ ok: true, text: "hello" });
+    expect(seen!.url).toBe(DEFAULT_TRANSCRIBE_URL);
+    const file = seen!.body.get("file") as File;
+    expect(file.name).toBe("dictation.ogg");
+    expect(seen!.body.get("response_format")).toBe("json");
+  });
+
+  it("refuses empty and oversized clips without a request", async () => {
+    const deps = depsWith({});
+    expect(
+      (await transcribeAudio(backend, { audioBase64: "", mimeType: "audio/webm" }, deps)).ok,
+    ).toBe(false);
+    const huge = Buffer.alloc(7 * 1024 * 1024).toString("base64");
+    expect(
+      (await transcribeAudio(backend, { audioBase64: huge, mimeType: "audio/webm" }, deps)).ok,
+    ).toBe(false);
+  });
+});
